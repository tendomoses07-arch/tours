# KOLA TOURS AND TRAVEL — Environment Configuration
# Copy this file to .env and customize for your deployment environment.

PORT=5000
NODE_ENV=development

# Authentication Secret (replace with a strong 64+ char secret in production)
JWT_SECRET=kola-tours-secret-key-change-in-production-2026
JWT_EXPIRES_IN=7d

# Database Path (SQLite embedded / PostgreSQL URL ready)
DATABASE_PATH=./data/kola_tours.sqlite
BACKUP_DIR=./data/backups

# Uploads Storage Directory (Kept outside public static folder for passport/visa privacy)
UPLOAD_DIR=./data/uploads

# Configurable SMTP Email Settings (Leave blank to log email payloads to console & database)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KOLA TOURS AND TRAVEL <no-reply@kolatours.com>"

# Initial Administrator Account (seeded on first startup if not exists)
ADMIN_EMAIL=admin@kolatours.com
ADMIN_PASSWORD=Admin@KolaTours2026!
ADMIN_NAME="Kola Tours Administrator"

